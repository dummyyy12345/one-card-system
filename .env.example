# Docker Compose settings. Copy to .env and replace the placeholders.
API_SECRET=replace-with-a-long-random-secret
DB_USER=onecard
DB_PASSWORD=replace-with-a-database-password
DB_NAME=onecard
NEXT_PUBLIC_API_SERVER_URL=http://localhost:8888

# Optional external integrations
DEVICE_USERNAME=
DEVICE_PASSWORD=
SERVICE=
SERVICE_TOKEN=
READER_HMAC_KEYS=
# 0 disables automatic audit deletion until an institutional policy is chosen.
ACCESS_EVENT_RETENTION_DAYS=0
STUDENT_VIEW_AUDIT_RETENTION_DAYS=0
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
